# ─────────────────────────────────────────────────────────────
# Mindset Finance – Variables de Entorno
# Copia este archivo como .env.local y rellena tus claves reales
# NUNCA subas .env.local a GitHub (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────

# Anthropic Claude API (para parsing de audio y asistente proactivo)
VITE_ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI Whisper API (transcripción de audio a texto)
# Si prefieres usar solo Claude, puedes dejarlo vacío y usar el modo simulado
VITE_OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXX

# Entorno de la app
VITE_APP_ENV=development
